####################################
# Voyage Client configuration file #
####################################
#
# server.js reads conf/client.conf (TOML), creating it from this file on first start, then every
# other conf/*.conf in the same folder. Each key may be defined in only one file. client.conf is
# gitignored: change your settings there, not in this template. Restart the server after a change.
# `node server.js --conf <dir>` reads another folder instead.
[voyage]
###################################################################################################
# SECTION INDEX
#
#  CLIENT SYSTEM SETTINGS
#    SERVER
#    RELAY
#    BUILD
#
#  QUALITY OF LIFE SETTINGS
#    ACCOUNT
#    BUFFS
#    COMBAT
#    LADDERS
#    LOGIN
#    MONSTERS
#    SKILLS
#
###################################################################################################

###################################################################################################
#                                                                                                 #
# CLIENT SYSTEM SETTINGS BEGIN                                                                    #
#                                                                                                 #
###################################################################################################

###################################################################################################
# SERVER
#
#     Server.Host
#        Description: The address the web server listens on.
#        Default:     "0.0.0.0" - every interface.

Server.Host = "0.0.0.0"

#
#     Server.Port
#        Description: The port for the page, the assets and the WebSocket relay (/ws).
#        Default:     3000

Server.Port = 3000

#
#     Server.AssetsDir
#        Description: The assets folder the Voyage extractor made (JSON + PNG), relative to the
#                     folder server.js is in. Voyage-Server and Voyage-Editor point at the same one.
#                     A file in its customs folder (assets/customs, laid out like the assets) is
#                     served in place of the one of the same name, and one only it has is served
#                     as well: that is where Voyage-Editor publishes to.
#        Default:     "../voyage-assets"

Server.AssetsDir = "../voyage-assets"

#
#     Server.Sheets
#        Description: Packs the many small images of each character file (one for every piece of
#                     every frame of a pose), NPC, monster and tile set into a few sheets, so a
#                     crowd of players loads in hundreds of requests instead of many thousands and
#                     a town in a couple of hundred instead of six. Bosses and other very large
#                     images are left as they are. The sheets are made from your assets
#                     when the server starts (the first start takes a little longer; after that
#                     only files that changed are made again) and kept in Server.CacheDir. The
#                     assets folder is never written to.
#        Default:     true
#                     false - every image is sent on its own.

Server.Sheets = true

#
#     Server.CacheDir
#        Description: The folder for what the server makes from the assets (the sheets),
#                     relative to the folder server.js is in. It can be deleted at any time: the
#                     server makes it again on the next start.
#        Default:     "cache"

Server.CacheDir = "cache"

#
###################################################################################################

###################################################################################################
# RELAY
#
#     Relay.Servers
#        Description: The game servers the relay connects players to, as name=host pairs
#                     separated by commas, e.g. "gameserver=127.0.0.1,test=10.0.0.5". With more than
#                     one, the login screen lets players pick; the first is the default. A host
#                     on its own ("10.0.0.5") is named after itself. Only the login port (8484) and
#                     the channel ports (7575-7699) are relayed.
#        Default:     "gameserver=127.0.0.1"

Relay.Servers = "gameserver=127.0.0.1"

#
###################################################################################################

###################################################################################################
# BUILD
#
#     Build.Obfuscate
#        Description: Minifies and obfuscates the client bundle (public/Voyage.js) when server.js
#                     builds it on start. `node build.mjs` reads it too.
#        Default:     false

Build.Obfuscate = false

#
###################################################################################################

###################################################################################################
#                                                                                                 #
# QUALITY OF LIFE SETTINGS BEGIN                                                                  #
#                                                                                                 #
###################################################################################################

###################################################################################################
# ACCOUNT
#
#     Account.SkipBirthdayCode
#        Description: Skips the 8-digit birthday code prompt everywhere: gifts, couple and
#                     friendship rings, name changes and world transfers in the Cash Shop, opening
#                     a shop with Cash items for sale, and managing your store.
#                     Account.BirthdayCode is sent instead. The server still checks it against the
#                     account's birthday, so a wrong one is turned down as usual.
#        Default:     false - the client asks for the code.

Account.SkipBirthdayCode = false

#
#     Account.BirthdayCode
#        Description: The code sent when Account.SkipBirthdayCode is on, as YYYYMMDD. The game server
#                     gives every account it creates the birthday 2005-05-11; change this if your
#                     accounts have another. With the skip on, every player's browser is sent this
#                     code, so don't use a birthday that should stay private.
#        Default:     20050511

Account.BirthdayCode = 20050511

#
###################################################################################################

###################################################################################################
# BUFFS
#
#     Buffs.ShowTimeLeft
#        Description: Writes the time left under each buff icon at the top right: seconds under a
#                     minute, minutes and seconds under an hour, then hours.
#        Default:     false - the icons only shade over as they run out.

Buffs.ShowTimeLeft = false

#
###################################################################################################

###################################################################################################
# COMBAT
#
#     Combat.NoWhack
#        Description: With a bow, crossbow, claw or gun, attacks always shoot or throw, even with a
#                     monster right in front. Normally a monster within the weapon's swing (65 px)
#                     turns a plain attack and most shooting skills into a swing with the weapon,
#                     and stops Hurricane, Rapid Fire and Piercing Arrow. Mortal Blow can still go
#                     off close up. With no ammo left, or lying down, you still swing or stab.
#        Default:     false - a monster that close gets the swing.

Combat.NoWhack = false

#
###################################################################################################

###################################################################################################
# LADDERS
#
#     Ladders.ClimbSpeedMultiplier
#        Description: Multiplies how fast you climb ladders and ropes, from 1.0 up to 3.0 (1.5 is
#                     half as fast again). The climbing animation and your pets keep pace. Other
#                     players see you climb at that speed too.
#        Default:     1.0 - the normal climbing speed.

Ladders.ClimbSpeedMultiplier = 1.0

#
###################################################################################################

###################################################################################################
# LOGIN
#
#     Login.TypePic
#        Description: Lets you type your PIC on the keyboard while the PIC soft keyboard is open.
#                     Letters and digits go in as if clicked; the on-screen keys still work.
#        Default:     false - only the on-screen keys type.

Login.TypePic = false

#
###################################################################################################

###################################################################################################
# MONSTERS
#
#     Monsters.BossHpPercent
#        Description: Writes the boss's HP, as a percentage, on the boss HP bar at the top of the
#                     screen.
#        Default:     false - the bar alone.

Monsters.BossHpPercent = false

#
###################################################################################################

###################################################################################################
# SKILLS
#
#     Skills.ShowCooldownTime
#        Description: Writes the time left on a skill's cooldown under its quick slot icon, in the
#                     same style as Buffs.ShowTimeLeft: seconds under a minute, minutes and seconds
#                     under an hour, then hours.
#        Default:     false - the icon only clears from the top as the cooldown runs out.

Skills.ShowCooldownTime = false

#
###################################################################################################
